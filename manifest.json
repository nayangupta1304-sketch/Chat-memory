{
  "manifest_version": 3,
  "name": "Chat Memory",
  "version": "3.1.0",
  "description": "A private, password-encrypted memory circle for ChatGPT, Claude and Gemini. One tap to capture, summarise, sort and save; import any file; per-site unlock.",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "alarms",
    "idle"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "dock.html",
        "dock.js",
        "pwcheck.js",
        "backupfmt.js"
      ],
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*"
      ]
    }
  ]
}